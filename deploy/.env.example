# Local infrastructure credentials (docker-compose). Copy to .env.
MONGO_USER=pheme
MONGO_PASS=change-me-with-a-random-password
MONGO_DB=pheme

RABBIT_USER=pheme
RABBIT_PASS=change-me-with-a-random-password

# Host ports for the infra containers. Override if the defaults are taken
# (scripts/setup.sh sets these automatically).
# MONGO_HOST_PORT=27017
# RABBIT_HOST_PORT=5672
# RABBIT_MGMT_HOST_PORT=15672
# REDIS_HOST_PORT=6379

# --- Pheme service configuration (consumed by the Go binaries) ---
# PHEME_APP_ADDR=:8080
# PHEME_INGEST_ADDR=:8081

# Backend drivers. Default to in-memory/log so the services run with no infra.
# Switch to the real adapters once the docker-compose stack is running:
# PHEME_STORE_DRIVER=mongo        # memory | mongo
# PHEME_BROKER_DRIVER=rabbit      # memory | rabbit
# PHEME_LIVE_DRIVER=redis         # memory | redis
# PHEME_RATELIMIT_DRIVER=redis    # memory | redis
# PHEME_PUSH_DRIVER=both          # log | fcm | webpush | both

# Connection strings. Note authSource=admin for the root user created by compose.
# PHEME_MONGO_URI=mongodb://pheme:pheme@localhost:27017/?authSource=admin
# PHEME_MONGO_DB=pheme
# PHEME_RABBIT_URI=amqp://guest:guest@localhost:5672/
# PHEME_REDIS_ADDR=localhost:6379

# Auth
#
# A real random value (`openssl rand -base64 32`). The API refuses to start on any
# placeholder from this repository — a published signing key mints admin tokens for
# anyone who reads it. Unset means a random per-process secret: fine for local
# development, but every restart signs you out.
# PHEME_JWT_SECRET=
# PHEME_ACCESS_TTL=15m
# PHEME_REFRESH_TTL=720h
# Comma-separated emails granted the admin role on register/login.
# PHEME_ADMIN_EMAILS=admin@example.com,boss@example.com

# Push credentials (secrets — never commit the real values)
# PHEME_FCM_CREDENTIALS=/run/secrets/firebase-service-account.json
# PHEME_VAPID_PUBLIC=
# PHEME_VAPID_PRIVATE=
# PHEME_VAPID_SUBJECT=mailto:admin@example.com
