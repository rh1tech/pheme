# Per-environment Pheme stack configuration.
# Copy to the server (for example `/opt/pheme/stack.env`),
# fill in the secrets, and keep it out of version control (chmod 600).

# Container images (set by CI/CD to the pushed tag).
API_IMAGE=ghcr.io/rh1tech/pheme-api:latest
WEB_IMAGE=ghcr.io/rh1tech/pheme-web:latest
SITE_IMAGE=ghcr.io/rh1tech/pheme-site:latest

# Host ports (bound to 127.0.0.1; the host nginx proxies to these).
# Prod: 8190/8191/8192   Dev: 8195/8196/8197
WEB_HOST_PORT=8190
SITE_HOST_PORT=8193
APP_HOST_PORT=8191
INGEST_HOST_PORT=8192

# The unlisted path prefix the API is mounted under, so that everything else on
# the API host is a plain static site and an unauthenticated prober finds no
# endpoint that behaves like an API. Generate one per deployment:
#
#     openssl rand -hex 8
#
# Feeds deploy/nginx/render.sh, which builds the vhost. NOT a security boundary
# — every endpoint behind it still authenticates — and not a secret either: it
# travels in the URL of every request, so anything terminating TLS in front of
# this host sees it. It is unlisted, which is enough to defeat the automated
# sweeps that build blocklists.
#
# It must appear in PHEME_API_BASE below, and nowhere else: no client code
# knows about the prefix, it simply arrives as part of the base URL.
PHEME_PATH_PREFIX=change-me-openssl-rand-hex-8

# Public API base URL baked into the web container at runtime. Also reused as
# PHEME_PUBLIC_API_URL (image URLs in push notifications). Message images are
# stored in MongoDB GridFS (PHEME_BLOB_DRIVER=gridfs, set in docker-compose.yml),
# so no extra storage or env var is needed.
#
# MUST INCLUDE PHEME_PATH_PREFIX. It is what carries the prefix to every client:
# the web SPA reads it at runtime from /config.js, the mobile app takes it as
# its server URL, and the server builds absolute push-notification image URLs
# from it. A base URL missing the prefix means every request lands on the decoy
# site, which presents as a total outage rather than a misconfiguration.
# Example: https://chat.example.com/<prefix>
PHEME_API_BASE=https://chat.example.com/change-me-openssl-rand-hex-8

# The web app's own origin, and the only one allowed to call the API from a
# browser (PHEME_CORS_ORIGINS). Comma-separated if you genuinely serve the SPA
# from more than one hostname. This was previously a blanket "*", which let any
# page on the internet call the API and told an unauthenticated prober that this
# host serves a browser API — something static hosting never does.
# Example: https://app.example.com
PHEME_WEB_ORIGIN=https://app.example.com

# Infrastructure credentials (internal-only services).
MONGO_USER=pheme
MONGO_PASS=change-me-strong
RABBIT_USER=pheme
RABBIT_PASS=change-me-strong

# This instance's own identity.
#
# PHEME_HOST_DOMAIN is the name peers know this host by; it becomes the issuer
# and audience of every token it mints. PHEME_HOST_KEY is its Ed25519 signing
# key -- generate one with:
#
#     docker run --rm --entrypoint /usr/local/bin/pheme-hostkey $API_IMAGE -env
#
# Leaving both empty keeps the pre-federation behaviour: tokens signed HS256
# with PHEME_JWT_SECRET below. That mode cannot survive federation, because a
# token's subject is a bare user id -- two hosts sharing a secret would each
# accept the other's tokens and authenticate as whichever local user held the
# same id, with a signature that verifies and nothing visibly wrong.
#
# Turning the key on stops shared-secret tokens verifying IMMEDIATELY, unless you
# declare a migration window with PHEME_JWT_LEGACY_UNTIL below. Set it to a date
# past the longest refresh token already issued (30 days by default) and nobody is
# signed out; leave it unset and everyone re-authenticates once.
#
# The window is a date, not a flag, so it closes by itself. While it is open the
# host still accepts HS256 — which is the state the key exists to leave behind.
PHEME_HOST_DOMAIN=chat.example.com
PHEME_HOST_KEY=
# PHEME_JWT_LEGACY_UNTIL=2026-09-01T00:00:00Z

# Auth.
#
# PHEME_JWT_SECRET must be a real random value -- generate one with
# `openssl rand -base64 32`. The API REFUSES TO START on any placeholder that
# appears in this repository, because a published signing key lets anyone mint a
# token for any user, including an admin.
#
# Do NOT simply delete this line to "turn it off": an unset secret makes the API
# generate a random one per process, so every session ends at each restart. That
# is deliberate — there is no default secret to fall back to, because a default
# would be exactly the forgeable key described above.
PHEME_JWT_SECRET=
PHEME_ADMIN_EMAILS=admin@example.com

# Registration is invite-only by default: an account can only be created with a link
# an admin generated in the panel (Admin -> Invites). An open relay accumulates
# accounts nobody vouched for, so opening signup has to be said out loud.
PHEME_INVITE_ONLY=true

# Set when a reverse proxy that OVERWRITES X-Forwarded-For sits in front (the
# deploy/nginx configs do). It tells the API to rate-limit per real client
# address. Leave it off if nothing proxies this API: the header is client-supplied,
# and trusting it without a proxy lets any caller rotate its apparent address and
# walk straight through the per-IP limits.
PHEME_TRUST_PROXY_HEADERS=true

# Email (verification codes + password reset). The app relays through the host's
# Postfix over the docker bridge; Postfix DKIM-signs and delivers direct-to-MX.
# No SMTP auth on the internal relay. Set PHEME_MAIL_DRIVER=log to print codes to
# the app logs instead of sending (handy for the dev environment).
PHEME_MAIL_DRIVER=smtp
PHEME_SMTP_HOST=host.docker.internal
PHEME_SMTP_PORT=25
PHEME_SMTP_FROM=Pheme <noreply@example.com>
# Enable only for a trusted relay on the private Docker bridge whose certificate
# cannot be verified by the container.
PHEME_SMTP_INSECURE_TLS=false

# Web Push (generate with: cd api && go run ./cmd/vapidgen -env).
# PHEME_VAPID_SUBJECT must be an https: URL — Apple Web Push rejects mailto:
# with 403 BadJwtToken. Use the dev site URL for the dev environment.
PHEME_VAPID_PUBLIC=
PHEME_VAPID_PRIVATE=
PHEME_VAPID_SUBJECT=https://app.example.com

# Mobile push (FCM). Set the driver to "both" to send Web Push (browsers) AND
# FCM (mobile); leave unset/"webpush" to disable FCM for this environment.
PHEME_PUSH_DRIVER=both
# Absolute path on the HOST to the Firebase service-account JSON (Project
# settings → Service accounts → Generate new private key). Mounted read-only
# into the dispatcher. The API image runs as non-root uid 65532, so secure it
# with: sudo chown 65532:65532 <file> && sudo chmod 600 <file>. Keep out of git.
PHEME_FCM_CREDENTIALS_HOST=/opt/pheme/fcm-service-account.json

# --- 1:1 voice calls (WebRTC) ------------------------------------------------
#
# Media is peer to peer and never touches the server. These configure the two things a
# browser needs before it can find its peer:
#
#   STUN — learn your own public address. Free, stateless.
#   TURN — relay the media for the pairs that cannot reach each other directly at all
#          (symmetric NAT — most mobile carriers). This is the ONLY path by which call
#          media transits this machine. Budget ~50 MB per hour per relayed call.
#
# THE URLS POINT AT THE ORIGIN, NOT AT THE PROXIED HOSTNAME. TURN is not HTTP, so
# Cloudflare cannot proxy it: a hostname on an orange cloud resolves to Cloudflare and the
# TURN server would be unreachable. Use the origin's own address, or a DNS-only (grey-cloud)
# name that resolves to it.
#
# No `turns:` (TLS on 5349). This host serves a Cloudflare ORIGIN certificate, which is
# trusted by Cloudflare and by no browser on earth. Enabling TLS-TURN needs a publicly
# trusted cert on a DNS-only name — see deploy/prod/turnserver.conf.
#
# Leave PHEME_TURN_URLS empty to switch calling off entirely: the API then refuses the ICE
# endpoint outright and the client hides the call button, rather than shipping one that can
# only ever fail.
#
# PHEME_TURN_SECRET must equal what coturn is started with. Generate: openssl rand -hex 32
PHEME_TURN_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
PHEME_TURN_SECRET=
PHEME_TURN_REALM=example.com

# coturn is opt-in: it stays down until the host is ready for it. Set this to bring it up.
COMPOSE_PROFILES=calls

# Host firewall must allow: 3478/udp, 3478/tcp, 49160-49200/udp
