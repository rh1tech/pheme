<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Runtime notification permission on Android 13+ (requested at startup). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Camera permission for scanning channel QR codes (mobile_scanner). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Voice calls. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Routing between the earpiece, the loudspeaker and a headset. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- API 31+: required to route a call to a paired headset. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Keeps the connection alive while the screen is off during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!--
        The lock-screen ringer.

        A full-screen intent, NOT ConnectionService. ConnectionService buys the system in-call UI and
        Telecom audio routing, at the cost of MANAGE_OWN_CALLS, a PhoneAccount the user has to enable
        by hand on several OEMs, and a long tail of vendor breakage. For a 1:1 audio call with our own
        in-call UI, a high-importance full-screen-intent notification gives us the one thing we
        actually need — to ring a locked phone — and nothing we do not.

        Android 14+ grants USE_FULL_SCREEN_INTENT automatically only to apps whose core function is
        calling; otherwise it silently degrades to a heads-up notification. It also needs a Play
        Console declaration.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!--
        The foreground service that holds the microphone for the duration of a call.

        Type `microphone`, not `phoneCall`: phoneCall requires MANAGE_OWN_CALLS and a Telecom-managed
        call, which is the ConnectionService path we are deliberately not on.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <application
        android:label="Pheme"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- The channel the system tray draws a message notification on.

             Without this, FCM has no channel to use for a notification it renders itself, so it
             invents one: fcm_fallback_notification_channel, named "Misc", at DEFAULT importance
             with vibration off. Everything still arrives, which is why this went unnoticed — but
             it arrives on the wrong channel, and that has consequences the app cannot override.

             The app creates pheme_messages at HIGH importance with vibration on. HIGH is what
             makes a message appear as a heads-up banner; DEFAULT drops it silently into the
             shade. And a user adjusting "Pheme messages" in system settings was configuring a
             channel that nothing was being delivered on, so their choices did nothing.

             Only affects tray-rendered notifications. A preview arrives data-only and is drawn by
             the app on the right channel already, which is why this is invisible to anyone testing
             with previews on. Verified on a Pixel 9: before this, the posted record read
             channel=fcm_fallback_notification_channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pheme_messages" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
